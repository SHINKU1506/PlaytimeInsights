<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:PlaytimeInsights.Models">
    <SolidColorBrush x:Key="RankingGoldBrush" Color="#FFD6B34B" />
    <SolidColorBrush x:Key="RankingGoldFillBrush" Color="#33D6B34B" />
    <SolidColorBrush x:Key="RankingSilverBrush" Color="#FFBFC7D5" />
    <SolidColorBrush x:Key="RankingSilverFillBrush" Color="#33BFC7D5" />
    <SolidColorBrush x:Key="RankingBronzeBrush" Color="#FFC9824A" />
    <SolidColorBrush x:Key="RankingBronzeFillBrush" Color="#33C9824A" />
    <SolidColorBrush x:Key="RankingEnergyBrush" Color="#FF4A90E2" />

    <!-- Trend chart semantic brushes. AdaptiveTrendChart.OnRender resolves these by
         key and never rebuilds a gradient per frame; the control keeps matching
         frozen static fallbacks for the case where this dictionary is absent.
         The line brush is the product's primary blue-to-violet gesture.
         The area fill is tuned against the dark module surface (#1B1C24). Measured
         on that surface: the top stop composites to 1.648:1, just above the
         gridline's own 1.525:1, so the fill reads as a distinct region; the mid stop
         holds 1.263:1 so the body of the fill keeps weight instead of dying early.
         Gridlines are drawn BEFORE the area and show through it, and they stay
         legible at these alphas (local contrast inside the fill 1.36:1 at the top,
         1.47:1 at the mid). The line itself sits at 5.10:1 and is never at risk.
         An earlier 0x30 -> 0x18 ramp falling off at 0.55 was rejected: at 1.273:1 the
         fill was fainter than the gridlines painted under it, so it had no presence
         in dark mode. Do not lower these alphas back toward 0x30, and do not push the
         top past about 0x66, where the gridlines start washing out.
         If these values change, CreateFallbackTrendAreaBrush in AdaptiveTrendChart
         must be updated to match; a test asserts the two stay in sync.
         There is no TrendNodeRingBrush by design. The node ring - normal and hover
         alike - resolves the theme's ControlBackgroundBrush, so it tracks Playnite
         Light and Dark. A fixed near-white ring such as #CCF3F4F6 was evaluated and
         rejected: it loses its edge on a light surface, which is the same defect as
         falling back to Brushes.White, just carried by a resource. -->
    <LinearGradientBrush x:Key="TrendLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2F8CFF" Offset="0" />
        <GradientStop Color="#FFA45CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TrendAreaFillBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#5A3B82F6" Offset="0" />
        <GradientStop Color="#2E5B7CFA" Offset="0.62" />
        <GradientStop Color="#005B7CFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TrendNodeFillBrush" Color="#FF4A90E2" />
    <!-- Low-emphasis wash behind the not-yet-observed tail of the trend chart.
         Deliberately neutral and faint: it separates "no data yet" from "played
         nothing" without introducing a new saturated semantic color and without
         competing with the hover crosshair. -->
    <SolidColorBrush x:Key="TrendFutureFillBrush" Color="#0DFFFFFF" />

    <!-- Calendar heatmap levels: a one-hue ICE-CYAN ordinal ramp on the dark module
         surface (ModuleBackgroundBrush, effective #1B1C24), with a visible per-cell
         aurora sheen matching the Week x Hour grid's.
         The cyan family is deliberate: the Week x Hour heatmap above it keeps the
         blue-violet HeatmapActiveBrush, and the two grids use INCOMPATIBLE scales -
         Calendar is absolute (fixed 0 / <1h / 1-3h / >3h buckets), Week x Hour is
         relative to the current range maximum. Cyan stays in the same cool family
         (so the card still reads as one surface) while clearing the blue-violet grid:
         EVERY stop below measures dE >= 15 (normal vision) from both Week x Hour
         stops #2457D6 and #A45CFF. The bluest stop allowed anywhere in this ramp is
         about #0C5F7A (dE 15.4 from #2457D6); #0B5F80 already fails at 14.4, so the
         sheen is widened GREEN-ward, never further toward blue.
         Do NOT use a navy anchor. #1D4ED8 was evaluated and rejected: it sits
         dE 2.2 (normal) from #2457D6, i.e. visually the same color as the grid above,
         and a navy-to-cyan ramp spans 53 deg of hue, failing the one-hue check.
         SHEEN STRENGTH. Reference: the Week x Hour brush's two stops sit dE 19.1
         apart. This ramp's per-level stop pairs measure dE 11.6 / 11.8 / 19.6
         (Low / Medium / High) - deliberately growing with level, mirroring the
         original where sheen scaled with HeatOpacity. Low and Medium stop short of
         19 on purpose: the Week x Hour grid is a CONTINUOUS opacity scale with no
         discrete levels, so it can spend lightness freely on sheen, whereas these
         four buckets are encoded BY lightness - intra-cell lightness spread directly
         eats inter-level separability. Low/Medium therefore get their sheen mostly
         from hue rotation (which costs no level signal) plus a small lightness tilt.
         Validated as an ordinal ramp against #1B1C24 by gradient midpoint
         (#16685F / #129D9E / #28D4E0): monotone L, adjacent dL >= 0.06,
         light end 2.57:1, hue spread 19 deg. Both anchor sub-ramps also validate
         (sky-ward light end 2.26:1, green-ward 2.92:1), so no corner of any cell
         drops through the contrast floor.
         High keeps the previously approved mean brightness: its stops are 7.66:1 and
         11.49:1, averaging ~9.6:1 against the flat #22D3EE it replaces (9.39:1) -
         the cell now shimmers without the grid getting louder. All Sessions can
         realize 1800+ cells, so do not raise the medium or high steps further.
         The None level is deliberately recessive - it means "no play", not a ramp
         step, and the 1 DIP PanelSeparatorBrush outline is what makes the empty
         cell read as a grid slot. Do not reintroduce per-level hue shifts. -->
    <SolidColorBrush x:Key="HeatmapNoneBrush" Color="#14FFFFFF" />
    <LinearGradientBrush x:Key="HeatmapLowBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF0C5C74" Offset="0" />
        <GradientStop Color="#FF20734A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeatmapMediumBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF0692B8" Offset="0" />
        <GradientStop Color="#FF1EA884" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeatmapHighBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF0EBAFF" Offset="0" />
        <GradientStop Color="#FF42EEC0" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="RankingEnergyBackgroundBarStyle"
           TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource RankingEnergyBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       Opacity="0.10" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaytimeInsightsDetailItemStyle"
           TargetType="{x:Type ListViewItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <ContentPresenter ContentSource="Content"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaytimeInsightsDetailListStyle"
           TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="MetricDurationForegroundBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="MetricDurationBackgroundBrush" Color="#203B82F6" />
    <SolidColorBrush x:Key="MetricSessionForegroundBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="MetricSessionBackgroundBrush" Color="#208B5CF6" />
    <SolidColorBrush x:Key="MetricActivityForegroundBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="MetricActivityBackgroundBrush" Color="#20F59E0B" />
    <SolidColorBrush x:Key="MetricAnomalyForegroundBrush" Color="#FFFB7185" />
    <SolidColorBrush x:Key="MetricAnomalyBackgroundBrush" Color="#20F43F5E" />

    <LinearGradientBrush x:Key="MetricCardBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#FF2B2D37" Offset="0" />
        <GradientStop Color="#FF202128" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetricCardRimLightBorderBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#FF3A3E4D" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ModuleBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#FF1E2028" Offset="0" />
        <GradientStop Color="#FF181920" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ModuleRimLightBorderBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ToolbarSurfaceBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1"
                         Opacity="0.88">
        <GradientStop Color="#FF1E212B" Offset="0" />
        <GradientStop Color="#FF161820" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToolbarSurfaceRimLightBorderBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#FF2E3342" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ToolbarLabelBrush" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="MetricCardTextBrush" Color="#FFF0F0F5" />
    <SolidColorBrush x:Key="MetricCardMutedTextBrush" Color="#FF9CA3AF" />

    <!-- Quick range chips. Idle chips stay low-emphasis so exactly the chip whose
         preset equals Filter.SelectedRangeOption reads as active. The selected
         state keeps a visible border (never a color-only change), hover and
         pressed feedback apply only to idle chips because clicking an active
         chip is a protected no-op, and the focus ring stays distinguishable from
         selection. Disabled chips dim last so they never read as clickable. -->
    <SolidColorBrush x:Key="QuickRangeIdleBackgroundBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="QuickRangeIdleBorderBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="QuickRangeHoverBackgroundBrush" Color="#264A90E2" />
    <SolidColorBrush x:Key="QuickRangeHoverBorderBrush" Color="#664A90E2" />
    <SolidColorBrush x:Key="QuickRangePressedBackgroundBrush" Color="#334A90E2" />
    <SolidColorBrush x:Key="QuickRangeSelectedBackgroundBrush" Color="#1A4A90E2" />
    <SolidColorBrush x:Key="QuickRangeSelectedBorderBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="QuickRangeFocusBrush" Color="#FFF0F0F5" />

    <LinearGradientBrush x:Key="RankingGoldGlowBrush"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#1AFFD700" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RankingSilverGlowBrush"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#1AE2E8F0" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RankingBronzeGlowBrush"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#1ACD7F32" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RankingGoldTopHighlightBrush" Color="#4DFFD700" />
    <LinearGradientBrush x:Key="RankingHoverBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DrilldownSessionHoverOverlayBrush" Color="#0F60A5FA" />
    <SolidColorBrush x:Key="DrilldownSessionHoverBorderBrush" Color="#4D60A5FA" />

    <LinearGradientBrush x:Key="DrilldownCardBackgroundBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="#FF262934" Offset="0" />
        <GradientStop Color="#FF1F212A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DrilldownAccentBrush" Color="#FF4A90E2" />
    <SolidColorBrush x:Key="DrilldownDividerBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="DrilldownGameNameBrush" Color="#FFF0F0F5" />
    <SolidColorBrush x:Key="DrilldownTimestampBrush" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="DrilldownDurationBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DrilldownSessionItemBackgroundBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DrilldownSessionHoverBackgroundBrush" Color="#20FFFFFF" />

    <SolidColorBrush x:Key="SessionTrackedBrush" Color="#FF4A90E2" />
    <SolidColorBrush x:Key="SessionTrackedFillBrush" Color="#1A4A90E2" />
    <SolidColorBrush x:Key="SessionImportedBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="SessionImportedFillBrush" Color="#20A78BFA" />
    <SolidColorBrush x:Key="SessionManualBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="SessionManualFillBrush" Color="#20FBBF24" />
    <SolidColorBrush x:Key="SessionRecoveredBrush" Color="#FFFB7185" />
    <SolidColorBrush x:Key="SessionRecoveredFillBrush" Color="#20FB7185" />

    <Style x:Key="SessionSourceTagStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}"
                         Value="{x:Static models:SessionSource.Tracked}">
                <Setter Property="BorderBrush" Value="{StaticResource SessionTrackedBrush}" />
                <Setter Property="Background" Value="{StaticResource SessionTrackedFillBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}"
                         Value="{x:Static models:SessionSource.Imported}">
                <Setter Property="BorderBrush" Value="{StaticResource SessionImportedBrush}" />
                <Setter Property="Background" Value="{StaticResource SessionImportedFillBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}"
                         Value="{x:Static models:SessionSource.Manual}">
                <Setter Property="BorderBrush" Value="{StaticResource SessionManualBrush}" />
                <Setter Property="Background" Value="{StaticResource SessionManualFillBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}"
                         Value="{x:Static models:SessionSource.Recovered}">
                <Setter Property="BorderBrush" Value="{StaticResource SessionRecoveredBrush}" />
                <Setter Property="Background" Value="{StaticResource SessionRecoveredFillBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
