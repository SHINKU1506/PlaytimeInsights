<Window x:Class="PlaytimeInsights.Views.SessionImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LOCPlaytimeInsightsImportPreviewTitle}"
        Width="920"
        Height="680"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PopupBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource LOCPlaytimeInsightsImportPreview}"
                   FontSize="26"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,8,0,14">
            <TextBlock Text="{Binding Summary}"
                       AutomationProperties.Name="{Binding Summary}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding FormatSummaryText}"
                       Opacity="0.65"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="{DynamicResource LOCPlaytimeInsightsImportPreviewHint}"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="2"
                  Header="{DynamicResource LOCPlaytimeInsightsImportableSessions}">
            <ListBox ItemsSource="{Binding CandidateItems}"
                     AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsImportableSessions}"
                     TabIndex="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="38" MinWidth="720" Margin="6,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GameName}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StartedAtText}"
                                       VerticalAlignment="Center"
                                       Opacity="0.72" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ElapsedText}"
                                       VerticalAlignment="Center"
                                       Opacity="0.72" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding ImportConfidence}"
                                       VerticalAlignment="Center"
                                       Opacity="0.62"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,12,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ErrorCountText}"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{DynamicResource LOCPlaytimeInsightsSaveErrorsButton}"
                    AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsSaveErrorsButton}"
                    TabIndex="2"
                    Padding="12,5"
                    Click="SaveErrorsButton_Click" />
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Errors}"
                 AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsSaveErrorsButton}"
                 TabIndex="1"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource LOCPlaytimeInsightsCancelButton}"
                    AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsCancelButton}"
                    TabIndex="3"
                    MinWidth="96"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{DynamicResource LOCPlaytimeInsightsConfirmImportButton}"
                    AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsConfirmImportButton}"
                    TabIndex="4"
                    MinWidth="110"
                    Padding="14,7"
                    IsDefault="True"
                    IsEnabled="{Binding CanImport}"
                    Click="ImportButton_Click" />
        </StackPanel>
    </Grid>
</Window>
