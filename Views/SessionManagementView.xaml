<UserControl x:Class="PlaytimeInsights.Views.SessionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
             KeyboardNavigation.TabNavigation="Continue"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style x:Key="HelpIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
        <Style x:Key="SessionListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="3,0,0,1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource GlyphBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource GlyphBrush}"
                        CornerRadius="2"
                        Margin="0,2,0,2" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsSessionsTitle}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsSessionsSubtitle}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0">
                <Button Content="{DynamicResource LOCPlaytimeInsightsAddButton}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsAddButton}"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="AddSessionButton_Click" />
                <Button Content="{DynamicResource LOCPlaytimeInsightsEditButton}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsEditButton}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanEdit}"
                        Click="EditSessionButton_Click" />
                <Button Content="{DynamicResource LOCPlaytimeInsightsDeleteButton}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsDeleteButton}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanDelete}"
                        Click="DeleteSessionButton_Click" />
                <Button Content="{DynamicResource LOCPlaytimeInsightsRestoreButton}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsRestoreButton}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanRestore}"
                        Click="RestoreSessionButton_Click" />
                <Button Content="{DynamicResource LOCPlaytimeInsightsRefreshButton}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsRefreshButton}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource LOCPlaytimeInsightsDataTools}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <WrapPanel>
                    <Button Content="{DynamicResource LOCPlaytimeInsightsImportButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsImportButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ImportButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsFullBackupButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsFullBackupButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackupButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsRestoreBackupButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsRestoreBackupButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RestoreBackupButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsReindexButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsReindexButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ReindexButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsDiagnosticsButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsDiagnosticsButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,20,8"
                            ToolTip="{DynamicResource LOCPlaytimeInsightsDiagnosticsTooltip}"
                            Click="DiagnosticsButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsExportCsvButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsExportCsvButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasFilteredSessions}"
                            Click="ExportCsvButton_Click" />
                    <Button Content="{DynamicResource LOCPlaytimeInsightsExportJsonButton}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsExportJsonButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasFilteredSessions}"
                            Click="ExportJsonButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsSearchMetadata}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsSearchMetadata}"
                             Width="260"
                             Padding="6,4" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsSessionSource}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding SourceOptions}"
                               AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsSessionSource}"
                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="140" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsMetadataDimension}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding MetadataDimensionOptions}"
                               AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsMetadataDimension}"
                              SelectedItem="{Binding SelectedMetadataDimension, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="150" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsFilterValue}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding MetadataValueOptions}"
                               AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsFilterValue}"
                              SelectedItem="{Binding SelectedMetadataValue, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              Width="210" />
                </StackPanel>
                <CheckBox Content="{DynamicResource LOCPlaytimeInsightsIncludeDeleted}"
                          AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsIncludeDeleted}"
                          IsChecked="{Binding IncludeDeleted, Mode=TwoWay}"
                          VerticalAlignment="Bottom"
                          Margin="18,0,0,5" />
            </WrapPanel>
        </Border>

        <WrapPanel Grid.Row="3" Margin="2,0,2,8">
            <TextBlock Text="{Binding CountText}"
                       Opacity="0.7"
                       Margin="0,0,18,3" />
            <TextBlock Text="{Binding StatusText}"
                       AutomationProperties.Name="{Binding StatusText}"
                       Opacity="0.55"
                       TextWrapping="Wrap"
                       Margin="0,0,0,3" />
        </WrapPanel>

        <Border Grid.Row="4"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Border MinWidth="860"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource LOCPlaytimeInsightsGameLabel}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource LOCPlaytimeInsightsStartTime}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{DynamicResource LOCPlaytimeInsightsDuration}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{DynamicResource LOCPlaytimeInsightsSessionSource}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4"
                                       Text="{DynamicResource LOCPlaytimeInsightsSessionState}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Text="{DynamicResource LOCPlaytimeInsightsLibrary}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ScrollViewer>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Sessions}"
                         AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsSessionsTitle}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SessionListItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48" MinWidth="860" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding GameName}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StartedText}"
                                           VerticalAlignment="Center"
                                           Opacity="0.75" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DurationText}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Opacity="0.86" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SourceText}"
                                           VerticalAlignment="Center"
                                           Opacity="0.68" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding StateText}"
                                           VerticalAlignment="Center"
                                           Opacity="0.68" />
                                <TextBlock Grid.Column="5"
                                           Text="{Binding LibraryName}"
                                           VerticalAlignment="Center"
                                           Opacity="0.68"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="{DynamicResource LOCPlaytimeInsightsLoadMore200}"
                    AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsLoadMore200}"
                    Visibility="{Binding LoadMoreVisibility}"
                    HorizontalAlignment="Center"
                    Padding="20,7"
                    Click="LoadMoreButton_Click" />
            <Button Content="?"
                    Style="{StaticResource HelpIconButtonStyle}"
                    AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                    ToolTip="{DynamicResource LOCPlaytimeInsightsImportSafetyHint}"
                    VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
