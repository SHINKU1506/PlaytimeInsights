<UserControl x:Class="PlaytimeInsights.Views.PlaytimeInsightsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:PlaytimeInsights.Converters"
             xmlns:controls="clr-namespace:PlaytimeInsights.Controls"
             xmlns:services="clr-namespace:PlaytimeInsights.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1200"
             KeyboardNavigation.TabNavigation="Continue"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/PlaytimeInsightsVisualResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <converters:CoverImageConverter x:Key="CoverImageConverter" />
        <sys:Double x:Key="TextOpacityPrimary">1</sys:Double>
        <sys:Double x:Key="TextOpacitySecondary">0.72</sys:Double>
        <sys:Double x:Key="TextOpacityTertiary">0.58</sys:Double>
        <sys:Double x:Key="TextOpacityDisabled">0.45</sys:Double>
        <LinearGradientBrush x:Key="WeekdaySelectedBackgroundBrush"
                             StartPoint="0.5,0"
                             EndPoint="0.5,1">
            <GradientStop Color="#334A90E2" Offset="0" />
            <GradientStop Color="#1A4A90E2" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WeekdaySelectedBorderBrush"
                             StartPoint="0,0.5"
                             EndPoint="1,0.5">
            <GradientStop Color="#FF4A90E2" Offset="0" />
            <GradientStop Color="#FF8B5CF6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="WeekdaySelectedIndicatorBrush" Color="#FF60A5FA" />
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="MetricCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Background" Value="{StaticResource MetricCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetricCardRimLightBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="MinHeight" Value="154" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="MetricComparisonTagStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TrendKind}" Value="Increase">
                    <Setter Property="Background" Value="#1A4ADE80" />
                    <Setter Property="BorderBrush" Value="#334ADE80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TrendKind}" Value="Decrease">
                    <Setter Property="Background" Value="#1A60A5FA" />
                    <Setter Property="BorderBrush" Value="#3360A5FA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricComparisonTagTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF9CA3AF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TrendKind}" Value="Increase">
                    <Setter Property="Foreground" Value="#FF4ADE80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TrendKind}" Value="Decrease">
                    <Setter Property="Foreground" Value="#FF60A5FA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnomalyMetricIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource MetricAnomalyBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#33FB7185" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AnomalyCount}" Value="0">
                    <Setter Property="Background" Value="#14FFFFFF" />
                    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnomalyMetricIconTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MetricAnomalyForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AnomalyCount}" Value="0">
                    <Setter Property="Foreground" Value="#FF9CA3AF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModulePanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Background" Value="{StaticResource ModuleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ModuleRimLightBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource MetricCardTextBrush}" />
        </Style>
        <Style x:Key="ToolbarSurfaceStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Background" Value="{StaticResource ToolbarSurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarSurfaceRimLightBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="Padding" Value="12,14" />
        </Style>
        <Style x:Key="DrilldownCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Background" Value="{StaticResource DrilldownCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MetricCardRimLightBorderBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="RankingItemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RankingHoverBackgroundBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Position}" Value="1">
                    <Setter Property="Background" Value="{StaticResource RankingGoldGlowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="2">
                    <Setter Property="Background" Value="{StaticResource RankingSilverGlowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="3">
                    <Setter Property="Background" Value="{StaticResource RankingBronzeGlowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RankingTopHighlightStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position}" Value="1">
                    <Setter Property="Background" Value="{StaticResource RankingGoldTopHighlightBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DrilldownSessionItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DrilldownSessionItemBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DrilldownSessionHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostIconButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="GhostButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostButtonBorder"
                                        Property="Background"
                                        Value="#264A90E2" />
                                <Setter TargetName="GhostButtonBorder"
                                        Property="BorderBrush"
                                        Value="#664A90E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostButtonBorder"
                                        Property="Background"
                                        Value="#334A90E2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GhostButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource MetricCardTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RefreshGhostButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="#1A4A90E2" />
            <Setter Property="BorderBrush" Value="#664A90E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetricDurationForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RefreshGhostBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RefreshGhostBorder"
                                        Property="Background"
                                        Value="#264A90E2" />
                                <Setter TargetName="RefreshGhostBorder"
                                        Property="BorderBrush"
                                        Value="#804A90E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RefreshGhostBorder"
                                        Property="Background"
                                        Value="#334A90E2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RefreshGhostBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource MetricCardTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardMutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MetricHelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardMutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <SolidColorBrush x:Key="TrendIncreaseBrush" Color="#FF3FA46A" />
        <SolidColorBrush x:Key="TrendIncreaseFillBrush" Color="#243FA46A" />
        <SolidColorBrush x:Key="TrendDecreaseBrush" Color="#FF4E8FD1" />
        <SolidColorBrush x:Key="TrendDecreaseFillBrush" Color="#244E8FD1" />
        <LinearGradientBrush x:Key="ChartBarBrush"
                             StartPoint="0.5,1"
                             EndPoint="0.5,0">
            <GradientStop Color="#FF2457D6" Offset="0" />
            <GradientStop Color="#FF2F8CFF" Offset="0.62" />
            <GradientStop Color="#FFA45CFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeatmapActiveBrush"
                             StartPoint="0,1"
                             EndPoint="1,0">
            <GradientStop Color="#FF2457D6" Offset="0" />
            <GradientStop Color="#FFA45CFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="{StaticResource TextOpacitySecondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="InlineFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ToolbarLabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="HelpIconButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="HelpButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpButtonBorder"
                                        Property="Background"
                                        Value="#264A90E2" />
                                <Setter TargetName="HelpButtonBorder"
                                        Property="BorderBrush"
                                        Value="#664A90E2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HelpButtonBorder"
                                        Property="Background"
                                        Value="#334A90E2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HelpButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource MetricCardTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvancedFilterToggleStyle"
               TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{StaticResource RankingEnergyBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="AdvancedFilterToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AdvancedFilterToggleBorder"
                                        Property="Background"
                                        Value="#1A4A90E2" />
                                <Setter TargetName="AdvancedFilterToggleBorder"
                                        Property="BorderBrush"
                                        Value="#4D4A90E2" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AdvancedFilterToggleBorder"
                                        Property="Background"
                                        Value="#1A4A90E2" />
                                <Setter TargetName="AdvancedFilterToggleBorder"
                                        Property="BorderBrush"
                                        Value="#594A90E2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AdvancedFilterToggleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdvancedFilterExpanderStyle"
               TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{StaticResource RankingEnergyBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                    <ToggleButton x:Name="HeaderSite"
                                                  Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AdvancedFilterToggleStyle}"
                                                  IsChecked="{Binding IsExpanded,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}"
                                                  Focusable="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource LOCPlaytimeInsightsAdvancedFilters}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="▾"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  ContentSource="Content"
                                                  Margin="0,2,0,0"
                                                  Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RankingBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelSeparatorBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position}" Value="1">
                    <Setter Property="BorderBrush" Value="{StaticResource RankingGoldBrush}" />
                    <Setter Property="Background" Value="{StaticResource RankingGoldFillBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="2">
                    <Setter Property="BorderBrush" Value="{StaticResource RankingSilverBrush}" />
                    <Setter Property="Background" Value="{StaticResource RankingSilverFillBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="3">
                    <Setter Property="BorderBrush" Value="{StaticResource RankingBronzeBrush}" />
                    <Setter Property="Background" Value="{StaticResource RankingBronzeFillBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RankingPositionTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="{StaticResource TextOpacitySecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position}" Value="1">
                    <Setter Property="Foreground" Value="{StaticResource RankingGoldBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="2">
                    <Setter Property="Foreground" Value="{StaticResource RankingSilverBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Position}" Value="3">
                    <Setter Property="Foreground" Value="{StaticResource RankingBronzeBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="GameRankingItemTemplate">
            <Border Height="64"
                    Margin="0,2"
                    Style="{StaticResource RankingItemCardStyle}"
                    ToolTip="{Binding ProgressTooltipText}">
                <Grid>
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RankingBadgeStyle}">
                        <TextBlock Text="{Binding Position}"
                                   Style="{StaticResource RankingPositionTextStyle}" />
                    </Border>
                    <Border Grid.Column="1"
                            Width="36"
                            Height="50"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Image Source="{Binding CoverImagePath, Converter={StaticResource CoverImageConverter}}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Focusable="False"
                               IsHitTestVisible="False" />
                    </Border>
                    <ProgressBar Grid.ColumnSpan="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Style="{StaticResource RankingEnergyBackgroundBarStyle}" />
                    <StackPanel Grid.Column="2"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetailText}"
                                       FontSize="10"
                                       Opacity="{StaticResource TextOpacityTertiary}"
                                       TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="{Binding PrimaryValueText}"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0"
                               FontWeight="SemiBold"
                               Opacity="{StaticResource TextOpacityPrimary}" />
                </Grid>
                    <Border Style="{StaticResource RankingTopHighlightStyle}"
                            Height="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            SnapsToDevicePixels="True" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="WeekdayButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MetricCardTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="SelectionTransform" Y="0" />
                            </Grid.RenderTransform>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Ellipse x:Name="SelectionIndicator"
                                     Width="5"
                                     Height="5"
                                     Margin="0,6,6,0"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Fill="{StaticResource WeekdaySelectedIndicatorBrush}"
                                     Visibility="Collapsed"
                                     Focusable="False"
                                     IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#14FFFFFF" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource MetricCardTextBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource WeekdaySelectedBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource WeekdaySelectedBorderBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderThickness"
                                        Value="1" />
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF4A90E2"
                                                          BlurRadius="12"
                                                          ShadowDepth="2"
                                                          Direction="270"
                                                          Opacity="0.32" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Panel.ZIndex" Value="2" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-2"
                                                             Duration="0:0:0.12"
                                                             DecelerationRatio="0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionTransform"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.12"
                                                             AccelerationRatio="0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="{StaticResource TextOpacityDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
