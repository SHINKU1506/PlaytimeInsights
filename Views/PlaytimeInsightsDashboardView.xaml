                                                 MinWidth="320"
                                                 Cursor="Cross"
                                                 PeriodSelected="AdaptiveTrendChart_PeriodSelected" />
                </StackPanel>
            </Border>

            <Border x:Name="RankingModule"
                    Style="{StaticResource ModulePanelStyle}"
                    RenderTransformOrigin="0.5,0.5"
                    PreviewMouseDown="RankingModule_PreviewMouseDown"
                    PreviewKeyDown="RankingModule_PreviewKeyDown"
                    RequestBringIntoView="RankingModule_RequestBringIntoView"
                    controls:AdaptiveDashboardPanel.Zone="Secondary">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RankingModuleTransform" Y="0" />
                </Border.RenderTransform>
                <TabControl>
                    <TabItem Header="{DynamicResource LOCPlaytimeInsightsRangeRankingTab}"
                             AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsRangeRankingTab}">
                        <ItemsControl ItemsSource="{Binding RangeGameRankings}"
                                      ItemTemplate="{StaticResource GameRankingItemTemplate}" />
                    </TabItem>
                    <TabItem Header="{DynamicResource LOCPlaytimeInsightsLifetimeRankingTab}"
                             AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsLifetimeRankingTab}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LOCPlaytimeInsightsLifetimeRankingScope}"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"
                                       Opacity="{StaticResource TextOpacityTertiary}" />
                            <ItemsControl ItemsSource="{Binding LifetimeGameRankings}"
                                          ItemTemplate="{StaticResource GameRankingItemTemplate}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Border x:Name="DistributionModule"
                    Style="{StaticResource ModulePanelStyle}"
                    RenderTransformOrigin="0.5,0.5"
                    controls:AdaptiveDashboardPanel.Zone="Primary">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DistributionModuleTransform" Y="0" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource LOCPlaytimeInsightsTimeDistribution}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Button Content="?"
                                Style="{StaticResource HelpIconButtonStyle}"
                                AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                                ToolTip="{DynamicResource LOCPlaytimeInsightsDistributionDescription}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource LOCPlaytimeInsightsWeekdayDistribution}"
                                   FontWeight="SemiBold" />
                        <Button Content="?"
                                Style="{StaticResource HelpIconButtonStyle}"
                                AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                                ToolTip="{DynamicResource LOCPlaytimeInsightsWeekdayFilterHint}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding WeekdayDistribution}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Command="{Binding DataContext.SelectWeekdayCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        ToolTip="{Binding TooltipText}"
                                        Cursor="Hand"
                                        Style="{StaticResource WeekdayButtonStyle}"
                                        Margin="4,0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="110" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="42"
                                                Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource ChartBarBrush}"
                                                CornerRadius="7,7,0,0"
                                                ToolTip="{Binding TooltipText}" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding HourDistributionTitle}" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding HourDistribution}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="42" Margin="1,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="108" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="24"
                                                Height="{Binding BarHeight}"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource ChartBarBrush}"
                                                CornerRadius="6,6,0,0"
                                                ToolTip="{Binding TooltipText}" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Opacity="{StaticResource TextOpacityTertiary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{DynamicResource LOCPlaytimeInsightsWeekHourHeatmap}" FontWeight="SemiBold" Margin="0,20,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                                  HorizontalContentAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding AdvancedHourLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Width="32"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   Opacity="{StaticResource TextOpacityTertiary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding AdvancedWeekdayLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Height="32"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Opacity="{StaticResource TextOpacityTertiary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="1"
                                          Grid.Column="1"
                                          ItemsSource="{Binding WeekHourCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="30"
                                                Height="30"
                                                Margin="1"
                                                CornerRadius="3"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                                BorderThickness="1"
                                                ToolTip="{Binding TooltipText}">
                                            <Grid>
                                                <Border Background="{DynamicResource TextBrush}"
                                                        Opacity="0.06"
                                                        IsHitTestVisible="False" />
                                                <Border CornerRadius="2"
                                                        Background="{StaticResource HeatmapActiveBrush}"
                                                        Opacity="{Binding HeatOpacity}"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource LOCPlaytimeInsightsCalendarHeatmap}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Button Content="?"
                                Style="{StaticResource HelpIconButtonStyle}"
                                AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                                ToolTip="{DynamicResource LOCPlaytimeInsightsCalendarHint}" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                                  HorizontalContentAlignment="Center">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding HeatmapWeekdayLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Height="26"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Opacity="{StaticResource TextOpacityTertiary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="1"
                                          ItemsSource="{Binding HeatmapCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding HeatmapColumnCount}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="24"
                                                Height="24"
                                                Margin="1"
                                                CornerRadius="3"
                                                Visibility="{Binding CellVisibility}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource PanelSeparatorBrush}"
                                                BorderThickness="1"
                                                ToolTip="{Binding TooltipText}"
                                                Tag="{Binding}"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="HeatmapCell_MouseLeftButtonUp">
                                            <Grid>
                                                <Border Background="{DynamicResource TextBrush}"
                                                        Opacity="0.06"
                                                        IsHitTestVisible="False" />
                                                <Border CornerRadius="2"
                                                        Background="{StaticResource HeatmapActiveBrush}"
                                                        Opacity="{Binding HeatOpacity}"
                                                        IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border x:Name="AnomalyModule"
                    Style="{StaticResource ModulePanelStyle}"
                    RenderTransformOrigin="0.5,0.5"
                    controls:AdaptiveDashboardPanel.Zone="Secondary"
                    Visibility="{Binding AnomalyVisibility}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AnomalyModuleTransform" Y="0" />
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource LOCPlaytimeInsightsAnomalyReviewTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="?"
                                Style="{StaticResource HelpIconButtonStyle}"
                                AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                                ToolTip="{DynamicResource LOCPlaytimeInsightsAnomalyDescription}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Anomalies}"
                             MaxHeight="300"
                             HorizontalContentAlignment="Stretch"
                             PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" MinWidth="760" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GameName}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StartedText}"
                                               VerticalAlignment="Center"
                                               Opacity="{StaticResource TextOpacitySecondary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationText}"
                                               VerticalAlignment="Center"
                                               Opacity="{StaticResource TextOpacitySecondary}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Reason}"
                                               VerticalAlignment="Center"
                                               Opacity="{StaticResource TextOpacityPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border x:Name="DrilldownModule"
                    Style="{StaticResource DrilldownCardStyle}"
                    controls:AdaptiveDashboardPanel.Zone="Primary"
                    IsVisibleChanged="DrilldownModule_IsVisibleChanged"
                    Visibility="{Binding SessionDetailVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{StaticResource DrilldownAccentBrush}"
                            CornerRadius="4,0,0,4"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                    <StackPanel Grid.Column="1" Margin="15,18,18,18">
                        <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDetailTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SessionDetailCountText}"
                                       FontSize="11"
                                       Opacity="{StaticResource TextOpacityTertiary}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostIconButtonStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding ClearDrilldownSelectionCommand}"
                                ToolTip="{DynamicResource LOCPlaytimeInsightsClearSelection}"
                                AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsClearSelection}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Opacity="{StaticResource TextOpacitySecondary}"
                                       IsHitTestVisible="False" />
                        </Button>
                    </Grid>
                    <Border Height="1"
                            Margin="0,0,0,6"
                            Background="{StaticResource DrilldownDividerBrush}"
                            SnapsToDevicePixels="True" />
                    <ListView ItemsSource="{Binding SessionDetails}"
                               Style="{StaticResource PlaytimeInsightsDetailListStyle}"
                               ItemContainerStyle="{StaticResource PlaytimeInsightsDetailItemStyle}"
                               MinHeight="160"
                               MaxHeight="380"
                               HorizontalContentAlignment="Stretch"
                               VerticalContentAlignment="Top"
                               Background="Transparent"
                               BorderThickness="0"
                               PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.CanContentScroll="True"
                               VirtualizingPanel.IsVirtualizing="True"
                               VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="DrilldownSessionRoot"
                                        Height="66"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource DrilldownSessionItemStyle}"
                                        RenderTransformOrigin="0.5,0.5"
                                        controls:HoverMotion.Enabled="True"
                                        controls:HoverMotion.LiftY="1"
                                        controls:HoverMotion.Duration="100">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DrilldownSessionTransform"
                                                            Y="0" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="50"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                ClipToBounds="True">
                                            <Image Source="{Binding CoverImagePath,
                                                Converter={StaticResource CoverImageConverter}}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Focusable="False"
                                                   IsHitTestVisible="False" />
                                        </Border>
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding GameName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DrilldownGameNameBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StartedText}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource DrilldownTimestampBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DurationText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource DrilldownDurationBrush}" />
                                                <Border Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SessionSourceTagStyle}"
                                                        AutomationProperties.Name="{Binding SourceText}">
                                                    <TextBlock Text="{Binding SourceText}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <Border x:Name="DrilldownSessionHoverOverlay"
                                                Grid.ColumnSpan="3"
                                                Background="{StaticResource DrilldownSessionHoverOverlayBrush}"
                                                BorderBrush="{StaticResource DrilldownSessionHoverBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=DrilldownSessionRoot}"
                                                                     Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="1"
                                                                                         Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="0"
                                                                         Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="{DynamicResource LOCPlaytimeInsightsLoadMore100}"
                            AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsLoadMore100}"
                            Visibility="{Binding LoadMoreVisibility}"
                            HorizontalAlignment="Center"
                            Padding="20,7"
                            Margin="0,10,0,0"
                            Command="{Binding LoadMoreSessionDetailsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            </controls:AdaptiveDashboardPanel>

            <DockPanel Margin="0,18,0,0">
                <Button DockPanel.Dock="Right"
                        Content="?"
                        Style="{StaticResource HelpIconButtonStyle}"
                        AutomationProperties.Name="{DynamicResource LOCPlaytimeInsightsHelp}"
                        ToolTip="{DynamicResource LOCPlaytimeInsightsDataBasisNote}" />
                <TextBlock Text="{Binding StatusText}"
                           AutomationProperties.Name="{Binding StatusText}"
                           Opacity="{StaticResource TextOpacityPrimary}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
